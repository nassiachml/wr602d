{% extends 'base.html.twig' %}
{% block title %}Dashboard - Paperless Engine{% endblock %}
{% block body %}
<h1>Dashboard</h1>
<p class="text-muted" style="margin-top: -0.5rem; margin-bottom: 1.5rem;">Vue d'ensemble de votre activité PDF</p>

<div class="stats-row">
  <div class="stat-card">
    <span class="stat-value">{{ count_this_month|default(0) }}</span>
    <span class="stat-label">PDF ce mois</span>
  </div>
  <div class="stat-card">
    <span class="stat-value">{{ count_total|default(0) }}</span>
    <span class="stat-label">Total générés</span>
  </div>
</div>

<div class="quota-card">
  <p class="section-tag">Quota du jour</p>
  {% set used = used_today %}
  {% set max = max_per_day %}
  {% set pct = max > 0 ? min(100, (used / max) * 100) : 0 %}
  <div class="progress-wrap">
    <div class="progress-label">
      <span><strong>{{ used }}</strong> PDF généré{{ used > 1 ? 's' : '' }}</span>
      <span>{{ max > 0 ? used ~ ' / ' ~ max : 'Illimité' }}</span>
    </div>
    <div class="progress-track">
      <div class="progress-bar
        {% if max == 0 or pct == 0 %}progress-bar--safe
        {% elseif pct >= 100 %}progress-bar--full
        {% elseif pct >= 80 %}progress-bar--danger
        {% elseif pct >= 50 %}progress-bar--warn
        {% else %}progress-bar--safe{% endif %}"
        style="width: {{ max > 0 ? pct ~ '%' : '0%' }};"></div>
    </div>
  </div>
</div>

{% if pending_tasks|length > 0 %}
<div class="card">
  <h2 style="font-size: 1.1rem; margin-bottom: 0.5rem;">File d'attente</h2>
  <p style="color: var(--text-muted); margin-bottom: 1rem;">{{ pending_tasks|length }} tâche(s) en attente.</p>
  <form action="{{ path('app_pdf_process_queue') }}" method="post">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('process_queue') }}">
    <button type="submit" class="btn">Lancer la génération</button>
  </form>
</div>
{% endif %}

<div style="margin-top: 1.5rem;">
  <a href="{{ path('app_pdf_generate') }}" class="btn">Générer un PDF</a>
  <a href="{{ path('app_pdf_history') }}" class="btn btn-secondary">Voir l'historique</a>
</div>
{% endblock %}
