<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Paperless Engine{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/paperless.css') }}">
    <script>
      (function() {
        var t = localStorage.getItem('paperless-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
</head>
<body>
<div class="layout">
    <nav class="sidebar">
        <div class="sidebar-top">
            <div class="brand">Paperless Engine</div>
            <div class="sidebar-top-actions">
                {% if is_granted('ROLE_USER') %}
                    {% set initial = (app.user.displayName ?? app.user.email)|slice(0, 1)|upper %}
                    <a href="{{ path('app_account') }}" class="sidebar-avatar" title="Mon compte" aria-label="Mon compte">
                        {% if app.user.avatarFilename %}
                            <img src="{{ url('app_account_avatar', { v: app.user.avatarFilename }) }}" alt="Avatar" class="sidebar-avatar__img" width="40" height="40" loading="lazy">
                        {% else %}
                            <span class="sidebar-avatar-initial">{{ initial ?: '?' }}</span>
                        {% endif %}
                    </a>
                {% endif %}
                <button type="button" class="theme-toggle" id="theme-toggle" title="Changer de thème" aria-label="Changer de thème">
                    <span class="theme-toggle-icon theme-icon-dark">☀</span>
                    <span class="theme-toggle-icon theme-icon-light">🌙</span>
                </button>
            </div>
        </div>
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="{{ path('app_dashboard') }}">Dashboard</a>
            <a href="{{ path('app_pdf_generate') }}">Générer un PDF</a>
            <a href="{{ path('app_pdf_history') }}">Historique PDF</a>
            <a href="{{ path('app_contacts') }}">Contacts</a>
            <a href="{{ path('app_subscriptions') }}">Abonnements</a>
            <a href="{{ path('app_account') }}">Mon compte</a>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
            <a href="{{ path('app_register') }}">Inscription</a>
        {% endif %}
    </nav>
    <main class="main">
        {% for message in app.flashes('success') %}
            <div class="flash-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash-error">{{ message }}</div>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</div>
<script>
(function() {
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  btn.addEventListener('click', function() {
    var html = document.documentElement;
    var next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('paperless-theme', next); } catch (e) {}
  });
})();
</script>
</body>
</html>
