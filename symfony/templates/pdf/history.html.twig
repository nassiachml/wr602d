{% extends 'base.html.twig' %}
{% block title %}Historique PDF - Paperless Engine{% endblock %}
{% block body %}
<h1>Historique PDF</h1>
<p class="text-muted" style="margin-top: -0.5rem; margin-bottom: 1.25rem;">Recherchez, filtrez et gérez vos PDF.</p>

<form method="get" action="{{ path('app_pdf_history') }}" class="history-toolbar card">
  <div class="history-toolbar__row">
    <input type="text" name="q" value="{{ search|default('') }}" placeholder="Rechercher (URL ou fichier…)" class="history-toolbar__search">
    <select name="status" class="history-toolbar__filter">
      <option value="">Tous les statuts</option>
      <option value="success" {{ status_filter == 'success' ? 'selected' : '' }}>Réussis</option>
      <option value="failed" {{ status_filter == 'failed' ? 'selected' : '' }}>Échecs</option>
    </select>
    <button type="submit" class="btn btn-secondary">Filtrer</button>
    {% if search or status_filter %}
      <a href="{{ path('app_pdf_history') }}" class="btn btn-secondary">Réinitialiser</a>
    {% endif %}
  </div>
</form>

<div class="card" style="overflow: hidden;">
  <table>
    <thead>
      <tr><th>Date</th><th>Fichier / URL</th><th>Statut</th><th>Actions</th></tr>
    </thead>
    <tbody>
    {% for pdf in pdfs %}
      <tr>
        <td>{{ pdf.createdAt|date('d/m/Y H:i') }}</td>
        <td>
          {% if pdf.originalUrl %}
            <a href="{{ pdf.originalUrl }}" target="_blank" rel="noopener" class="table-link" title="{{ pdf.originalUrl }}">{{ pdf.originalUrl|length > 50 ? pdf.originalUrl|slice(0, 50) ~ '…' : pdf.originalUrl }}</a>
          {% else %}
            {{ pdf.filename }}
          {% endif %}
        </td>
        <td>
          <span class="badge badge--{{ pdf.isSuccess ? 'success' : 'danger' }}">
            {{ pdf.isSuccess ? 'OK' : 'Échec' }}
          </span>
        </td>
        <td class="table-actions">
          {% if pdf.isSuccess %}
            <a href="{{ path('app_pdf_download', { id: pdf.id }) }}" class="btn btn-secondary btn-sm">Télécharger</a>
            {% if pdf.originalUrl %}
              <a href="{{ path('app_pdf_generate', { url: pdf.originalUrl }) }}" class="btn btn-secondary btn-sm">Regénérer</a>
            {% endif %}
          {% endif %}
          <form method="post" action="{{ path('app_pdf_delete', { id: pdf.id }) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce PDF de l\'historique ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('pdf_delete_' ~ pdf.id) }}">
            <input type="hidden" name="page" value="{{ page }}">
            {% if search|default('') is not empty %}<input type="hidden" name="q" value="{{ search }}">{% endif %}
            {% if status_filter|default('') is not empty %}<input type="hidden" name="status" value="{{ status_filter }}">{% endif %}
            <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="4" class="table-empty">Aucun PDF trouvé.</td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>

{% if total_pages|default(1) > 1 %}
<nav class="pagination">
  {% set query_params = { q: search, status: status_filter } %}
  {% if page > 1 %}
    <a href="{{ path('app_pdf_history', query_params|merge({ page: page - 1 })) }}" class="pagination__link">← Précédent</a>
  {% endif %}
  <span class="pagination__info">Page {{ page }} / {{ total_pages }}</span>
  {% if page < total_pages %}
    <a href="{{ path('app_pdf_history', query_params|merge({ page: page + 1 })) }}" class="pagination__link">Suivant →</a>
  {% endif %}
</nav>
{% endif %}

{% if total is defined and total > 0 %}
<p class="text-muted" style="margin-top: 0.75rem; font-size: 0.9rem;">{{ total }} PDF au total.</p>
{% endif %}

<p style="margin-top: 1.25rem;"><a href="{{ path('app_pdf_generate') }}" class="btn">Générer un PDF</a></p>
{% endblock %}
