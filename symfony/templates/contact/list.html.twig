{% extends 'base.html.twig' %}
{% block title %}Contacts - Paperless Engine{% endblock %}
{% block body %}
<h1>Contacts</h1>
<p><a href="{{ path('app_contact_new') }}" class="btn">Nouveau contact</a></p>
<table>
    <thead>
        <tr><th>Nom</th><th>Email</th><th></th></tr>
    </thead>
    <tbody>
    {% for c in contacts %}
        <tr>
            <td>{{ c.name ?? '-' }}</td>
            <td>{{ c.email }}</td>
            <td>
                <a href="{{ path('app_contact_edit', { id: c.id }) }}">Modifier</a>
                <a href="{{ path('app_contact_delete', { id: c.id }) }}">Supprimer</a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="3">Aucun contact.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
