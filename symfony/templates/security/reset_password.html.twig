{% extends 'base.html.twig' %}
{% block title %}Nouveau mot de passe - Paperless Engine{% endblock %}
{% block body %}
<h1>Nouveau mot de passe</h1>
<form method="post" action="{{ path('app_reset_password', { token: token }) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">
    <div class="form-group">
        <label for="password">Nouveau mot de passe (min. 6 caractères)</label>
        <input type="password" id="password" name="password" required minlength="6">
    </div>
    <button type="submit" class="btn">Enregistrer le mot de passe</button>
</form>
<p><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
{% endblock %}
