{% extends 'base.html.twig' %}
{% block title %}Connexion - Paperless Engine{% endblock %}
{% block body %}
<h1>Connexion</h1>
{% if error %}
    <div class="flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
{% endif %}
<form method="post" action="{{ path('app_login') }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <div class="form-group">
        <label for="username">Email</label>
        <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
    </div>
    <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" required>
    </div>
    <button type="submit" class="btn">Se connecter</button>
</form>
<p><a href="{{ path('app_register') }}">Créer un compte</a> — <a href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a></p>
{% endblock %}
