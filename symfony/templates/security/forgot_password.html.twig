{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié - Paperless Engine{% endblock %}
{% block body %}
<h1>Mot de passe oublié</h1>
{% if not sent %}
<form method="post" action="{{ path('app_forgot_password') }}">
    <div class="form-group">
        <label for="email">Email du compte</label>
        <input type="email" id="email" name="email" required>
    </div>
    <button type="submit" class="btn">Envoyer le lien de réinitialisation</button>
</form>
{% else %}
<p>Si un compte existe pour cet email, un lien de réinitialisation a été envoyé.</p>
{% endif %}
<p><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
{% endblock %}
